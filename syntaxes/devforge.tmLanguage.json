{
    "scopeName": "source.devforge",
    "name": "DevForge",
    "patterns": [
        {
            "name":"keyword.control.tag.devforge",
            "match":"@[a-zA-Z]+"
        },
        {
            "name":"variable.key.devforge",
            "match":"\\$[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*=)"
        },
        {
            "name":"keyword.operator.assignment.devforge",
            "match":"="
        },
        {
            "name":"string.quoted.double.devforge",
            "begin":"\"",
            "end":"\"",
            "patterns":[
                {
                    "name":"constant.character.escape.devforge",
                    "match":"\\\\."
                }
            ]
        },
        {
            "name":"comment.line.double-slash.devforge",
            "match":"//.*$"
        }
    ]
}