{
    "name": "devforge-language",
    "displayName": "DevForge",
    "description": "DevForge multi-tag scripting language for .Dev files",
    "version": "1.0.2",
    "publisher": "JacobS",
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "devforge",
                "aliases": [
                    "DevForge",
                    "devforge"
                ],
                "extensions": [
                    ".Dev",
                    ".dev",
                    ".DEV",
                    ".Log",
                    ".log",
                    ".LOG"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "devforge",
                "scopeName": "source.devforge",
                "path": "./syntaxes/devforge.tmLanguage.json"
            }
        ]
    }
}